 [Rewrite]
 ^https?:\/\/stats\.kwvprfcr\.xyz reject
 ^https?:\/\/mc\.yandex\.ru reject

 [Mitm]
 hostname = *.hlwxx.com, *.hlcx16.com, stats.kwvprfcr.xyz, mc.yandex.ru,hlwxx.com

 [Script]
 http-response ^https?:\/\/(?:www\.)?hl(?:wxx|cx\d*)\.com\/(?:$|\?|archives\/|category\/|memora|search|index\.htm) script-path=https://github.com/taikulayyds/vpn/raw/refs/heads/mina/Loon/hlwxx_remove_ads.js, requires-body=true, timeout=60, tag=黑料纯享版去广告