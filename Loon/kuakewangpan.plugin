#!name=夸克网盘
#!desc=非一次性解锁，每次使用需要先启用此插件，再进入应用方可解锁，解锁成功后支持版本升级。
#!openUrl=https://apps.apple.com/app/id1160172628
#!author=chxm1023[https://raw.githubusercontent.com/chxm1023/Rewrite/main/kuake.js]
#!tag=解锁
#!system=
#!system_version=
#!homepage=https://github.com/1074305015/chxm1023
#!icon=https://github.com/taikulayyds/icon/raw/refs/heads/mina/kuake.png
#!date=2025-07-07

[Script]
http-response ^https?:\/\/drive.*\.quark\.cn\/.+\/clouddrive\/(member.+|distribute\/detail.+|capacity\/growth\/info) script-path=https://raw.githubusercontent.com/chxm1023/Rewrite/main/kuake.js, requires-body=true, timeout=60, tag=夸克网盘

[MitM]
hostname = drive*.quark.cn
