 #!homepage=https://github.com/WeiGiegie
 #!icon=https://github.com/taikulayyds/icon/raw/refs/heads/mina/bdyy.png

 [Rewrite]
 # > 开屏AD&其它广告？(以下数据来自“广告必须死”频道分享)
 ^https://ad\.tencentmusic\.com/config/uni reject
 # 移除波点音乐我的页面广告banner
 ^https:\/\/bd-api\.kuwo\.cn\/api\/service\/banner\/positions\? reject-dict
 # 移除搜索框热搜
 ^https:\/\/bd-api\.kuwo\.cn\/api\/search\/topic\/word\/list\? reject-dict

 [Mitm]
 hostname = bd-api.kuwo.cn, *.kuwo.*, ad.tencentmusic.com, *.l.qq.com

 [Script]
 # > 波点音乐 会员调试 + 去广告 + 下载功能。
 1. 新增下载功能 : 默认下载 320kbps 音质歌曲，支持播放和离线保存。
 2. 会员特权调试 : VIP 数据更稳定，不再依赖个人页面加载权限，告别听歌无权限问题。
 3. 开屏广告去除 : 针对腾讯系广告 SDK，完整处理广告开关，它不是拒绝请求，还保证返回的 JSON 结构完整。
 4. 后续计划 : 当前脚本已非常完善，优化体验为主，持续关注性能与兼容性。（https://t.me/GieGie777）
 http-response ^https?:\/\/(bd-api\.kuwo\.cn\/api\/(ucenter\/users\/(pub|login)|play\/music\/v2\/(audioUrl|checkRight)|service\/(home\/module|music\/download\/info|global/config\/scene)|pay\/vip\/lowPriceText)|us\.l\.qq\.com\/exapp\?adposcount) script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/bdyy.js, requires-body=true, timeout=60, tag=波点音乐