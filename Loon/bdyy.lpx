 [Rewrite]
 ^https://ad\.tencentmusic\.com/config/uni reject

 [Mitm]
 hostname = bd-api.kuwo.cn, *.kuwo.*, ad.tencentmusic.com

 [Script]
  # > 波点音乐 解锁VIP 最高音质 + 去广告1.会员特权解锁：会员logo，支持最高2000k FLAC音质，新增歌曲下载（当前下载功能为自慰）2.bug修复：修复此前需手动切换播放、MV自动播放错误等问题3.广告优化：去除banner广告（开屏广告暂未去除，非完美）4.个人页面减少修改，尊重用户体验5.后续计划：即将支持下载功能及数字专辑解锁….（https://t.me/GieGie777）
 http-response ^https?:\/\/bd-api\.kuwo\.cn\/api\/(ucenter\/users\/pub|play\/music\/v2\/(audioUrl|checkRight)|service\/home\/module|pay\/vip\/lowPriceText) script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/bdyy.js, requires-body=true, timeout=60, tag=波点音乐