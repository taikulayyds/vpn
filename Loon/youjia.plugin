#!name=今日油价
#!desc=复制 cron "7 7 7 ? * *" script-path=https://raw.githubusercontent.com/taikulayyds/vpn/refs/heads/mina/Loon/youjia.js, timeout=10, tag=油价提醒, argument= 到配置文件[Script]下 在argument=后面填写"所在省份名"，不带"省"字 范例：argument="江苏"，argument="上海"，argument="广东"。或在本地脚本的参数中填写不带引号的省份名。此脚本使用的公开apikey ，建议自行申请apikey 然后自行修改脚本内的apikey 
#!author=yfamily[https://raw.githubusercontent.com/taikulayyds/vpn/refs/heads/mina/Loon/youjia.plugin]
#!icon=https://github.com/taikulayyds/icon/raw/refs/heads/mina/youjia.png
#!homepage=https://whatshub.top

[Argument]
jinriyoujia = switch,false,tag=今日油价

[Script]
cron "7 7 7 ? * *" script-path=https://raw.githubusercontent.com/deezertidal/private/main/oil.js, timeout=10, tag=油价提醒, argument="浙江"