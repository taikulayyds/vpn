 [Mitm]
 hostname = *.kkmh.com, *kkmh.com

 [Rewrite]
 ^https?://.*kkmh.com\/v3\/ad\/show reject-dict


 [Script]
 # >快看漫画 解锁VIP,去广告+提前看（https://t.me/GieGie777）
 http-response ^https?:\/\/.*kkmh.com\/v1\/vip\/me script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/kuaikanmanhua.js, requires-body=true, timeout=60, tag=快看漫画

 http-request ^https?:\/\/.*kkmh.com\/v2\/comic\/detail\/get script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/kuaikanmanhua.js, timeout=60, tag=快看漫画