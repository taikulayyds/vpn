 #!name=哔哩哔哩
 #!desc=1. 打开番剧页面，点击“分享”并复制链接。2. 稍等片刻即可获得最终地址（通常有效期为 30 秒 ~ 30 分钟，超时即失效）。3. 将复制的链接粘贴到浏览器并打开。4. 播放地址不要走代理！不要走代理！不要走代理！
 #!openUrl=https://apps.apple.com/app/id736536022
 #!author=lOS-脚本研究院[https://raw.githubusercontent.com/WeiGiegie/666/main/blblplayurl.js]
 #!date=2025-08-30
 #!homepage=https://github.com/WeiGiegie
 #!icon=https://github.com/taikulayyds/icon/raw/refs/heads/mina/bilibili.png


 [Mitm]
 hostname = api.bilibili.com, api.biliapi.net, *.bilivideo.com, *.bilivideo.cn

 [Script]
 # > 哔哩哔哩 播放地址获取与调试？通过接口解析*员视频地址，最终会将其拷贝到用户手中。 
 ＃说明：  
- 本脚本不会修改软件内的任何数据，仅通过分享短链接解析最终地址；  
- 但如果解析次数过多，可能会被官方判定为异常分享，存在封号风险；  
- 本脚本仅用于开发交流，请勿将其用于其他用途或牟利。（https://t.me/GieGie777）
 http-response ^https?:\/\/(api.bilibili.com|api.biliapi.net)\/x\/share\/click script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/blblplayurl.js, requires-body=true, timeout=60, tag=哔哩哔哩大会员
 http-request ^https?:\/\/.*bilivideo\.(com|cn)(?!.*\/resolve).*\/upgcxcode\/.*\.(m4s|flv|mp4|ts)(?=.*platform=pc) script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/blblplayurl.js, timeout=60, tag=哔哩哔哩大会员