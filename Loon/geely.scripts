http-response ^https?:\/\/app\.geely\.com\/my\/getMyCenterCounts$ script-path=https://raw.githubusercontent.com/wf021325/qx/master/task/geely.js, requires-body=true, binary-body-mode=true, timeout=10, tag=吉利汽车签到获取cookie, img-url=http://raw.githubusercontent.com/Xhy333/QuantumultX/main/icon/Jlqc.png

cron "5 8 * * *" script-path=https://raw.githubusercontent.com/wf021325/qx/master/task/geely.js, timeout=10, tag=吉利汽车签到, img-url=http://raw.githubusercontent.com/Xhy333/QuantumultX/main/icon/Jlqc.png
