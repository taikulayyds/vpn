#!name=吉利汽车签到
#!desc=添加脚本，获取cookie，每日自动签到。
#!openUrl=https://apps.apple.com/app/id1518762715
#!author=wf021325[https://github.com/wf021325/qx/raw/refs/heads/main/task/geely.js]
#!tag=解锁
#!system=
#!system_version=
#!homepage=https://github.com/wf021325/qx
#!icon=https://github.com/taikulayyds/icon/raw/refs/heads/mina/geely.png
#!date=2025-08-22

[Argument]
geely-cookie_enable = switch,true,false,tag=吉利汽车签到获取cookie
geely-qiandao_enable = switch,true,false,tag=吉利汽车每日签到
time = input,"5 8 * * *",tag=每日签到时间

[Script]
http-response ^https?:\/\/app\.geely\.com\/my\/getMyCenterCounts$ script-path=https://raw.githubusercontent.com/wf021325/qx/master/task/geely.js, requires-body=true, timeout=60, tag=吉利汽车签到获取cookie,enable={geely-cookie_enable}

cron {time} https://raw.githubusercontent.com/wf021325/qx/master/task/geely.js, timeout=120, enable={geely-qiandao_enable},tag=吉利汽车签到脚本
[MitM]
hostname = app.geely.com
